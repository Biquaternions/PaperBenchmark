From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Biquaternions <biquaternions@serlith.net>
Date: Fri, 9 Oct 2026 11:51:05 -0500
Subject: [PATCH] Add Profilers For Benchmark


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index c3bf41af0273e902f881cc070fcef6dd64abb063..5b4789673425df1974c46adecafdd1429ed39a5d 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1327,7 +1327,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                 // Paper - improve tick loop - done above
 
                 try (Profiler.Scope ignored = Profiler.use(this.createProfiler())) {
+                    final long startTickLoop = System.nanoTime(); // Benchmark
                     this.processPacketsAndTick(sprinting);
+                    me.biquaternions.benchmark.area.AreaType.TICK_SERVER.getProfiler().push(startTickLoop - System.nanoTime()); // Benchmark
                     ProfilerFiller profiler = Profiler.get();
                     profiler.push("nextTickWait");
                     this.mayHaveDelayedTasks = true;
@@ -1816,7 +1818,9 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         this.isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
 
         profiler.popPush("connection");
+        final long startConnection = System.nanoTime(); // Benchmark
         this.tickConnection();
+        me.biquaternions.benchmark.area.AreaType.TICK_CONNECTION.getProfiler().push(startConnection - System.nanoTime()); // Benchmark
         profiler.popPush("players");
         this.playerList.tick();
         profiler.popPush("debugSubscribers");
diff --git a/net/minecraft/server/level/ServerChunkCache.java b/net/minecraft/server/level/ServerChunkCache.java
index c4cfb53e145d69666ffc27ef4ee0c50b54eb9143..1f145bb83dde0213c5bd710552cf320134abd737 100644
--- a/net/minecraft/server/level/ServerChunkCache.java
+++ b/net/minecraft/server/level/ServerChunkCache.java
@@ -505,12 +505,18 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         profiler.popPush("chunks");
         if (tickChunks) {
             ((ca.spottedleaf.moonrise.patches.chunk_system.level.ChunkSystemServerLevel)this.level).moonrise$getPlayerChunkLoader().tick(); // Paper - rewrite chunk system
+            final long startChunks = System.nanoTime(); // Benchmark
             this.tickChunks();
+            me.biquaternions.benchmark.area.AreaType.TICK_CHUNKS.getProfiler().push(startChunks - System.nanoTime()); // Benchmark
             this.chunkMap.tick();
+            final long startTracking = System.nanoTime(); // Benchmark
+            me.biquaternions.benchmark.area.AreaType.TICK_ENTITY_TRACKING.getProfiler().push(startTracking - System.nanoTime()); // Benchmark
         }
 
         profiler.popPush("unload");
+        final long startChunkUnloads = System.nanoTime(); // Benchmark
         this.chunkMap.tick(haveTime);
+        me.biquaternions.benchmark.area.AreaType.TICK_CHUNK_UNLOADS.getProfiler().push(startChunkUnloads - System.nanoTime()); // Benchmark
         profiler.pop();
         this.clearCache();
     }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 8389d812b2d80a122fd1945b3182c08cdeda7d1c..4a19899e886b9550030a4f2b818614d91bc71210 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -851,9 +851,13 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         if (!this.isDebug() && runs) {
             long tick = this.getGameTime();
             profiler.push("blockTicks");
+            final long startBlocks = System.nanoTime(); // Benchmark
             this.blockTicks.tick(tick, paperConfig().environment.maxBlockTicks, this::tickBlock); // Paper - configurable max block ticks
+            me.biquaternions.benchmark.area.AreaType.TICK_BLOCKS.getProfiler().push(startBlocks - System.nanoTime()); // Benchmark
             profiler.popPush("fluidTicks");
+            final long startFluids = System.nanoTime(); // Benchmark
             this.fluidTicks.tick(tick, paperConfig().environment.maxFluidTicks, this::tickFluid); // Paper - configurable max fluid ticks
+            me.biquaternions.benchmark.area.AreaType.TICK_FLUIDS.getProfiler().push(startFluids - System.nanoTime()); // Benchmark
             profiler.pop();
         }
 
@@ -863,7 +867,9 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         }
 
         profiler.popPush("chunkSource");
+        final long startChunkSource = System.nanoTime(); // Benchmark
         this.getChunkSource().tick(haveTime, true);
+        me.biquaternions.benchmark.area.AreaType.TICK_CHUNK_SOURCE_FULL.getProfiler().push(startChunkSource - System.nanoTime()); // Benchmark
         profiler.popPush("blockEvents");
         if (runs) {
             this.runBlockEvents();
@@ -889,6 +895,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             }
 
             io.papermc.paper.entity.activation.ActivationRange.activateEntities(this); // Paper - EAR
+            final long startEntities = System.nanoTime(); // Benchmark
             this.entityTickList
                 .forEach(
                     entity -> {
@@ -915,9 +922,12 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                         }
                     }
                 );
+            me.biquaternions.benchmark.area.AreaType.TICK_ENTITIES.getProfiler().push(startEntities - System.nanoTime()); // Benchmark
             if (this.paperConfig().unsupportedSettings.ticking.blockEntities) { // Paper - option to disable ticking
             profiler.popPush("blockEntities");
+            final long startBlockEntities = System.nanoTime(); // Benchmark
             this.tickBlockEntities();
+            me.biquaternions.benchmark.area.AreaType.TICK_BLOCK_ENTITIES.getProfiler().push(startBlockEntities - System.nanoTime()); // Benchmark
             profiler.pop();
             } // Paper - option to disable ticking
             this.spigotConfig.currentPrimedTnt = 0; // Spigot
